<?xml version="1.0" encoding="utf-8"?>
<!-- Solo la variante sync declara red (WebDAV por HTTPS). Ver docs/06 y docs/09. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      «Importar de otro launcher» (vía proveedor de contenido): permisos NORMALES que declaran los launchers derivados de
      Launcher3 antiguos para leer su tabla `favorites`. Solo en sync, ver docs/09 y docs/DECISIONS.md. La variante default no
      los declara: allí solo funciona la vía de archivo de copia (selector de documentos). Nada de lo leído se envía a ninguna parte.
    -->
</manifest>
