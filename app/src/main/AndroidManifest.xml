<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifiesto de UltimateLauncher. Deriva de AndroidManifest.xml + AndroidManifest-common.xml de
  Launcher3 (AOSP android17-release, Apache-2.0) recortado según docs/09-privacidad.md. Ver patches/0001.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos (tabla de docs/09). NO hay INTERNET en la variante default. -->
    <uses-permission android:name="android.permission.BIND_APPWIDGET" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Solo se usa si el usuario lo pide en el asistente: abre el diálogo del sistema para que ColorOS/Android no mate el launcher. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <permission
        android:name="${applicationId}.permission.START_WIDGET_PICKER_ACTIVITY"
        android:protectionLevel="signature" />

    <!-- Visibilidad de paquetes: solo apps con actividad de lanzador (sin QUERY_ALL_PACKAGES). Ver docs/09 y DECISIONS. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- «Importar de otro launcher»: listar los launchers instalados (intent HOME). Visibilidad de paquetes, no es un permiso. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Paquetes de iconos (parches 0171-0173): descubrir los packs instalados por las acciones estándar de launchers (visibilidad de paquetes, no son permisos). -->
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="org.adw.launcher.icons.ACTION_PICK_ICON" /></intent>
        <intent><action android:name="com.anddoes.launcher.THEME" /></intent>
        <!-- Widget «Reloj digital»: saber si hay app de reloj que atienda el toque (no es un permiso). -->
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
    </queries>

    <application
        android:name="com.android.launcher3.LauncherApplication"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher_home"
        android:label="UltimateLauncher"
        android:theme="@style/AppTheme"
        android:largeHeap="@bool/config_largeHeap"
        android:supportsRtl="true"
        >

        <activity
            android:name="com.android.launcher3.Launcher"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustPan"
            android:screenOrientation="unspecified"
            android:configChanges="keyboard|keyboardHidden|mcc|mnc|navigation|orientation|screenSize|screenLayout|smallestScreenSize"
            android:resizeableActivity="true"
            android:resumeWhilePausing="true"
            android:taskAffinity=""
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.intent.action.SHOW_WORK_APPS" />
                <action android:name="android.intent.action.ALL_APPS" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER_APP" />
            </intent-filter>
        </activity>

        <!-- Asistente de primer arranque (M6). Icono propio para poder repetirlo. -->
        <activity
            android:name="com.qtekfun.ultimatelauncher.oem.FirstRunActivity"
            android:label="@string/ul_launcher_label"
            android:icon="@drawable/ic_setting"
            android:theme="@android:style/Theme.DeviceDefault.DayNight"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fondos de UltimateLauncher: pack incluido en el APK; se abre desde el menú del escritorio y los ajustes (parche 0170). -->
        <activity
            android:name="com.qtekfun.ultimatelauncher.wallpaper.WallpaperPickerActivity"
            android:label="@string/ul_wp_menu"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:exported="false"
            android:excludeFromRecents="true" />

        <!-- Importar la pantalla de inicio de otro launcher (archivo de copia o proveedor), sin red. Se abre desde Exportar/importar y desde el asistente. -->
        <activity
            android:name="com.qtekfun.ultimatelauncher.importer.ForeignImportActivity"
            android:label="@string/ul_imp_label"
            android:theme="@android:style/Theme.DeviceDefault.DayNight"
            android:exported="false" />

        <!-- Exportar/importar disposición (M7): archivo por el selector de documentos, sin red. -->
        <activity
            android:name="com.qtekfun.ultimatelauncher.layoutsync.LayoutSyncActivity"
            android:label="@string/ul_sync_label"
            android:icon="@drawable/ic_setting"
            android:theme="@android:style/Theme.DeviceDefault.DayNight"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="com.android.launcher3.widgetpicker.WidgetPickerActivity"
            android:theme="@style/WidgetPickerActivityTheme"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:launchMode="singleTop"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.PICK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

<!-- Widgets «Reloj digital» (propios): hora con TextClock, sin alarmas ni permisos. -->
        <receiver android:name="com.qtekfun.ultimatelauncher.clockwidget.ClockWidgetSquareLight"
            android:label="@string/ul_clock_label_square" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/ul_clock_widget_square_light" />
        </receiver>
        <receiver android:name="com.qtekfun.ultimatelauncher.clockwidget.ClockWidgetWideLight"
            android:label="@string/ul_clock_label_wide" android:exported="true">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/ul_clock_widget_wide_light" />
        </receiver>

        <receiver android:name="com.android.launcher3.SessionCommitReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.content.pm.action.SESSION_COMMITTED" />
            </intent-filter>
        </receiver>

        <receiver android:name="com.android.launcher3.AppWidgetsRestoredReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_HOST_RESTORED" />
            </intent-filter>
        </receiver>

        <!-- Puntos de notificación: solo si el usuario concede el acceso (desactivado por defecto). -->
        <service
            android:name="com.android.launcher3.notification.NotificationListener"
            android:label="@string/notification_dots_service_title"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity android:name="com.android.launcher3.dragndrop.AddItemActivity"
            android:theme="@style/AddItemActivityTheme"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
                <action android:name="android.content.pm.action.CONFIRM_PIN_APPWIDGET" />
            </intent-filter>
        </activity>

        <provider
            android:name="com.android.launcher3.LauncherProvider"
            android:authorities="${applicationId}.settings"
            android:exported="false" />

        <activity
            android:name="com.android.launcher3.settings.SettingsActivity"
            android:label="@string/settings_button_text"
            android:icon="@drawable/ic_setting"
            android:theme="@style/HomeSettings.Theme"
            android:exported="true"
            android:autoRemoveFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.android.launcher3.secondarydisplay.SecondaryDisplayLauncher"
            android:theme="@style/AppTheme"
            android:launchMode="singleTop"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.SECONDARY_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />

        <property
            android:name="android.window.PROPERTY_ACTIVITY_EMBEDDING_SPLITS_ENABLED"
            android:value="true" />

        <activity
            android:name="com.android.launcher3.organizer.creation.screen.ui.OrganizerActivity"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/OrganizerTheme" />

        <activity
            android:name="com.android.launcher3.organizer.creation.screen.ui.foldercreator.FolderCreatorActivity"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/FolderCreatorTheme" />
    </application>
</manifest>
