<?xml version="1.0" encoding="utf-8"?>
<!-- Vista previa del selector de widgets (Android 12+): reloj blanco 4x2 con hora fija. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/ul_clock_card_light"
    android:paddingStart="@dimen/ul_clock_padding_wide"
    android:paddingEnd="@dimen/ul_clock_padding_wide"
    android:paddingTop="@dimen/ul_clock_padding"
    android:paddingBottom="@dimen/ul_clock_padding">

    <TextView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:text="10:09"
        android:textColor="#000000"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeMaxTextSize="160sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:orientation="vertical"
        android:gravity="center_vertical|end">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/ul_clock_preview_weekday"
            android:textColor="#000000"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:text="@string/ul_clock_preview_monthday"
            android:textColor="#B3000000"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
